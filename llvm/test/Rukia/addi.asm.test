# RUN: llvm-mc %s -triple=riscv32 -assemble -show-encoding | FileCheck %s
# RUN: llvm-mc %s -triple=rukia32 -assemble -show-encoding | FileCheck %s

# CHECK: addi a0, a1, -1 # encoding: [0x13,0x85,0xf5,0xff]
addi x10, x11, -1
# CHECK: addi a0, a1, 2047 # encoding: [0x13,0x85,0xf5,0x7f]
addi x10, x11, 2047
# CHECK: addi a0, a1, -2048 # encoding: [0x13,0x85,0x05,0x80]
addi x10, x11, -2048
